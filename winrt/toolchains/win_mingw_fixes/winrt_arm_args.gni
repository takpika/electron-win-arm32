# GN build arguments of the Windows on ARM32 product build (Surface 2 / Windows RT 8.1 and
# Surface Pro X / Windows 11 ARM64 running ARM32). A build directory's args.gn is exactly:
#   import("/home/winrt/toolchains/win_mingw_fixes/winrt_arm_args.gni")
# Paths are those produced on the linux-arm64 build host by the recipes in this directory:
#   build_llvm_winrt.sh          -> /home/winrt/sdk/llvm-mingw-winrt  (compiler, linker)
#   build_winrt_sdk.sh           -> /home/winrt/sdk/winrt-sdk/vs      (setup_toolchain.py's
#                                                                       SDK layout)
#   build_winrt_crt_runtimes.sh  -> /home/winrt/sdk/winrt-crt         (runtimes for the
#                                                                       static CRT, per cpu)
#   xwin splat of the pinned Windows SDK 10.0.22621 + MSVC CRT/ATL -> /home/winrt/sdk/xwin-10.0.22621
#   DEPS-pinned Chromium linux sysroots (sysroots.json)             -> /home/winrt/sdk/sysroots

target_os = "win"
target_cpu = "arm"

# Toolchain (build/config/win/BUILD.gn, build/toolchain/win/toolchain.gni).
clang_base_path = "/home/winrt/sdk/llvm-mingw-winrt"
clang_version = "23"


visual_studio_path = "/home/winrt/sdk/winrt-sdk/vs"
windows_sdk_path = "/home/winrt/sdk/winrt-sdk/vs/win_sdk"
# Required alongside visual_studio_path by visual_studio_version.gni's assert; no build file of
# this configuration reads it further (no driver/WDK targets are built).
wdk_path = "/home/winrt/sdk/winrt-sdk/vs/win_sdk"
# Required whenever visual_studio_path is set (visual_studio_version.gni asserts it); the
# Microsoft C runtime this build links (the splat's crt/, MSVC 14.44) is Visual Studio 2022's.
visual_studio_version = "2022"
win_mingw_fixes_dir = "/home/winrt/toolchains/win_mingw_fixes"
win_sdk_supplement_dir = "/home/winrt/toolchains/win_sdk_supplement"
win_sdk_splat_dir = "/home/winrt/sdk/xwin-10.0.22621"
win_crt_runtimes_dir = "/home/winrt/sdk/winrt-crt"

# Linux host toolchains (V8 snapshot/generators for clang_arm, host tools for clang_arm64);
# use_sysroot is already true for both cpus (build/config/sysroot.gni).
target_sysroot_dir = "/home/winrt/sdk/sysroots"

# V8: the snapshot must be generated by a 32-bit ARM mksnapshot (32-bit object layout, and
# win-arm32 runs Thumb-2 only); on this linux-arm64 host the only toolchain producing
# executable 32-bit ARM binaries is the arm-linux one, run under qemu-arm with the arm sysroot
# (v8/gni/snapshot_toolchain.gni v8_arm_linux_exec_prefix).
v8_snapshot_toolchain = "//build/toolchain/linux:clang_arm"

# Release product build (is_debug and is_component_build default to false); every other
# argument keeps its official-build default (PGO, ThinLTO, allocator shim,
# PartitionAlloc-as-malloc, BackupRefPtr), except the media codec set below.
is_official_build = true

# chrome.dll's PDB at the official build's symbol_level (2, full debug info, as upstream's
# official Windows builds) is 4,296,462,336 bytes, over the 4 GiB a PDB with 4 KiB pages can
# hold (lld-link: "Output data is larger than 4 GiB ... try setting a larger /pdbpagesize").
# use_large_pdbs is upstream's switch for this (build/config/win/BUILD.gn: /pdbpagesize:8192,
# PDBs up to 8 GiB; lld-link supports it).
use_large_pdbs = true

# Media codecs: the port's target configuration is Chromium with Google Chrome's media codec set:
# H.264, AAC and the other proprietary codecs, as Google Chrome ships
# (build/config/features.gni proprietary_codecs; media/BUILD.gn requires ffmpeg_branding != "Chromium"
# with it). The ffmpeg configuration this selects for win/arm-neon is
# third_party/ffmpeg/chromium/config/Chrome/win/arm-neon (generated by build_ffmpeg.py).
proprietary_codecs = true
ffmpeg_branding = "Chrome"
