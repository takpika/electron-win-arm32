+; RUN: llc -mtriple=i686-w64-mingw32 -use-ctors=false < %s | FileCheck %s --check-prefix=NOMAIN
+; RUN: llc -mtriple=x86_64-pc-cygwin -use-ctors=false < %s | FileCheck %s --check-prefix=MAIN
+
+define i32 @main() {
+entry:
+  ret i32 0
+}
+
+; MAIN-LABEL: main:
