diff -ruN a/clang/test/Driver/mingw-cl-translate-args.c b/clang/test/Driver/mingw-cl-translate-args.c
--- a/clang/test/Driver/mingw-cl-translate-args.c	1970-01-01 00:00:00.000000000 +0000
+++ b/clang/test/Driver/mingw-cl-translate-args.c	2026-09-26 10:28:46.161736138 +0000
@@ -0,0 +1,46 @@
+// clang-cl command lines for a MinGW (*-windows-gnu) triple desugar /O, -D name#value
+// and /permissive[-] like the MSVC toolchain does, and honor an explicit /std:,
+// instead of ignoring them.
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /O2 -### -- %s 2>&1 | FileCheck -check-prefix=O2 %s
+// O2-NOT: argument unused during compilation
+// O2: "-O3"
+// O2: "-ffunction-sections"
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /O1 -### -- %s 2>&1 | FileCheck -check-prefix=O1 %s
+// O1: "-Os"
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /Od -### -- %s 2>&1 | FileCheck -check-prefix=OD %s
+// OD: "-O0"
+
+// RUN: %clang_cl --target=x86_64-w64-windows-gnu /O2 /Oy- -### -- %s 2>&1 | FileCheck -check-prefix=OY %s
+// OY: "-O3"
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /O2 /Oy- -### -- %s 2>&1 | FileCheck -check-prefix=OYARM %s
+// OYARM: "-mframe-pointer=all"
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu -DFOO#BAR -### -- %s 2>&1 | FileCheck -check-prefix=DHASH %s
+// DHASH: "-D" "FOO=BAR"
+
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /TP /std:c++20 -### -- %s 2>&1 | FileCheck -check-prefix=STD20 %s
+// STD20-NOT: argument unused during compilation
+// STD20: "-std=c++20"
+
+// RUN: %clang_cl --target=x86_64-w64-windows-gnu /TP /std:c++17 -### -- %s 2>&1 | FileCheck -check-prefix=STD17 %s
+// STD17: "-std=c++17"
+
+// A /std: that is not a C++ standard leaves the -gnu default (no MSVC default).
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /TP /std:c11 -### -- %s 2>&1 | FileCheck -check-prefix=STDC11 %s
+// STDC11-NOT: "-std=
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /TP /std:c++23 -### -- %s 2>&1 | FileCheck -check-prefix=STDBAD %s
+// STDBAD: argument unused during compilation: '/std:c++23'
+// STDBAD-NOT: "-std=
+
+// (/TP: this file is C, /std:c++ applies to C++ inputs.)
+// Without /std: the -gnu default is kept (no MSVC -std=c++14 default).
+// RUN: %clang_cl --target=armv7-w64-windows-gnu /TP -### -- %s 2>&1 | FileCheck -check-prefix=NOSTD %s
+// NOSTD-NOT: "-std=
+
+// Unchanged outside clang-cl mode.
+// RUN: %clang --target=armv7-w64-windows-gnu -O1 -### -c %s 2>&1 | FileCheck -check-prefix=GNU %s
+// GNU: "-O1"
