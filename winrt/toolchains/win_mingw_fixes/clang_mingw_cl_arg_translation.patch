 }
 
+llvm::opt::DerivedArgList *
+toolchains::MinGW::TranslateArgs(const llvm::opt::DerivedArgList &Args,
+                                 BoundArch BA,
+                                 Action::OffloadKind DeviceOffloadKind) const {
+  // A clang-cl command line for a MinGW triple: desugar /O, -D name#value and
+  // /permissive[-] exactly as the MSVC toolchain does. Without this they are
+  // accepted and silently ignored (e.g. /O2 compiles at -O0).
+  if (!getDriver().IsCLMode())
+    return nullptr;
+  return TranslateCLArgs(getDriver(), getTriple(), Args, DeviceOffloadKind);
+}
+
 bool toolchains::MinGW::HasNativeLLVMSupport() const {
   return NativeLLVMSupport;
 }
